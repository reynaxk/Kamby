{
  "name": "kamby",
  "private": true,
  "version": "0.0.0",
  "description": "Kamby — social crypto discovery and trading platform.",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\" --ignore-path .gitignore",
    "db:generate": "pnpm --filter @kamby/db generate",
    "db:migrate:deploy": "pnpm --filter @kamby/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @kamby/db migrate:dev",
    "db:studio": "pnpm --filter @kamby/db studio"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.3",
    "railway": "^3.11.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.3.0",
      "qs": ">=6.16.0",
      "lodash": ">=4.18.1",
      "uuid": "^9.0.1"
    }
  }
}
