{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build", "generate"],
      "outputs": [],
      "cache": false,
      "env": [
        "DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "CHAINS",
        "DEFAULT_CHAIN_SLUG",
        "CHAIN_BASE_ID",
        "CHAIN_BASE_RPC_URL",
        "CHAIN_BASE_USDC_ADDRESS",
        "PLATFORM_FEE_RECIPIENT_ADDRESS",
        "KYBERSWAP_CLIENT_ID"
      ]
    },
    "generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
