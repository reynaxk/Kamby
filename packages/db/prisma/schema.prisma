// Phase 0 schema: chains, tokens, token_markets only.
// See /docs/SOURCE_OF_TRUTH.md before adding a table — every fact needs exactly one
// authoritative owner, and this file is that owner for the entities defined here.

generator client {
  provider        = "prisma-client-js"
  // Default output location (node_modules/.prisma/client, re-exported via the
  // @prisma/client package) — deliberately not a custom path. A relative `output`
  // makes the generated client a source file tsc must account for under `rootDir`,
  // which stops being true the moment it's a normal package import instead.
  previewFeatures = ["postgresqlExtensions"]
  // "native" for local dev; explicit musl+OpenSSL-3.0 target for the node:20-alpine
  // Docker images (apps/api, apps/workers) — Prisma's own Alpine OpenSSL detection is
  // unreliable and silently defaults to a 1.1.x-linked engine binary that doesn't exist
  // on modern Alpine (3.17+, OpenSSL 3.x only), crashing at runtime with "Error loading
  // shared library libssl.so.1.1: No such file or directory".
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Declared now so `prisma migrate` provisions it, even though Phase 0 has no
  // hypertables yet — OHLCV candles land on this extension in a later phase.
  extensions = [timescaledb]
}

/// A blockchain network the platform knows about. `identifier` is the stable,
/// human-referenceable id (CAIP-2 style, e.g. "eip155:8453" for Base mainnet); `id` is
/// the internal numeric key used by foreign keys.
model Chain {
  id           Int      @id @default(autoincrement())
  identifier   String   @unique
  name         String
  nativeSymbol String   @map("native_symbol")
  /// Logical reference to this chain's RPC configuration (an env var key or provider
  /// config name) — never a raw RPC URL or API key. Resolved from environment/secrets
  /// at runtime; intentionally not a real endpoint value in this table.
  rpcConfigKey String   @map("rpc_config_key")
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tokens       Token[]
  tokenMarkets TokenMarket[]

  @@map("chains")
}

/// A token contract on a specific chain. `symbol`, `name`, `decimals`, and `logoUrl` are
/// nullable on purpose — they are facts about the chain, owned by the indexer, and must
/// never be fabricated by application code before the indexer has confirmed them.
model Token {
  id              String   @id @default(uuid())
  chainId         Int      @map("chain_id")
  contractAddress String   @map("contract_address")
  symbol          String?
  name            String?
  decimals        Int?
  logoUrl         String?  @map("logo_url")
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  chain             Chain              @relation(fields: [chainId], references: [id], onDelete: Restrict)
  marketsAsBase     TokenMarket[]      @relation("TokenMarketBaseToken")
  marketsAsQuote    TokenMarket[]      @relation("TokenMarketQuoteToken")
  tokenLots         TokenLot[]
  realizedPnlEvents RealizedPnlEvent[]
  tokenTheses       TokenThesis[]

  @@unique([chainId, contractAddress])
  @@index([chainId])
  @@map("tokens")
}

/// A specific liquidity venue a token trades on (a pool/pair on a DEX). Price and
/// liquidity live here, not on Token, because one token can trade across several pools —
/// and even several chains — at once.
///
/// `priceUsd`/`liquidityUsd`/`volume24hUsd`/`priceChange24hPct`/`marketCapUsd` are a
/// current-state cache — the authoritative history lives in `Swap` and `Candle`. These
/// fields are refreshed by the ingestion worker every tick and are rebuildable from that
/// history at any time; nothing should ever write to them by any other path. See
/// /docs/SOURCE_OF_TRUTH.md and /docs/MARKET_DATA.md.
model TokenMarket {
  id           String  @id @default(uuid())
  chainId      Int     @map("chain_id")
  tokenId      String  @map("token_id")
  quoteTokenId String  @map("quote_token_id")
  dex          String?
  pairAddress  String  @map("pair_address")
  /// Uniswap-V3-style fee tier in hundredths of a bip (500 = 0.05%, 3000 = 0.3%, ...).
  /// Read from the pool contract, not chosen by us.
  feeTier      Int?    @map("fee_tier")

  /// Nullable: unknown until the indexer observes this pool's reserves. Never a guess.
  liquidityUsd      Decimal?  @map("liquidity_usd") @db.Decimal(38, 18)
  /// Current price of `token` in USD, derived from the pool's own state. Null, never
  /// invented, when it can't be honestly computed (e.g. quote-token price unresolved).
  priceUsd          Decimal?  @map("price_usd") @db.Decimal(38, 18)
  /// Rolling 24h volume, summed from indexed `Swap` rows — not borrowed from a
  /// third party. Null (not zero) until at least one swap has been indexed.
  volume24hUsd      Decimal?  @map("volume_24h_usd") @db.Decimal(38, 18)
  /// Percent change vs. the earliest indexed price at least 24h old. Null — not 0% —
  /// when fewer than 24h of indexed history exist yet; see docs/MARKET_DATA.md.
  priceChange24hPct Decimal?  @map("price_change_24h_pct") @db.Decimal(12, 4)
  /// price * on-chain total supply (FDV-style). Null when total supply can't be read.
  /// Documented caveat: this is fully-diluted, not "circulating" — see docs/MARKET_DATA.md.
  marketCapUsd      Decimal?  @map("market_cap_usd") @db.Decimal(38, 2)
  /// When the price/liquidity snapshot above was last refreshed — the basis for the
  /// "stale" UI state; never inferred from `updatedAt` alone.
  lastPriceUpdateAt DateTime? @map("last_price_update_at")

  /// Phase 2 trending inputs, refreshed alongside volume24hUsd every ingestion tick from
  /// `swaps` — see docs/SOCIAL.md#trending. Same null-vs-zero rule as volume24hUsd: null
  /// until this market has ever had a swap indexed, 0 (not null) once it has but nothing
  /// falls in the current 24h window.
  tradeCount24h    Int? @map("trade_count_24h")
  uniqueTraders24h Int? @map("unique_traders_24h")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  chain             Chain               @relation(fields: [chainId], references: [id], onDelete: Restrict)
  token             Token               @relation("TokenMarketBaseToken", fields: [tokenId], references: [id], onDelete: Restrict)
  quoteToken        Token               @relation("TokenMarketQuoteToken", fields: [quoteTokenId], references: [id], onDelete: Restrict)
  swaps             Swap[]
  candles           Candle[]
  cursor            IngestionCursor?
  tradeQuotes       TradeQuote[]
  tradeTransactions TradeTransaction[]
  notifications     Notification[]
  trendingState     TokenTrendingState?
  watches           TokenWatch[]

  @@unique([chainId, pairAddress])
  @@index([tokenId])
  @@index([quoteTokenId])
  @@index([liquidityUsd])
  @@map("token_markets")
}

/// One on-chain Swap event, decoded and priced. The authoritative source of truth for
/// volume and historical price — `TokenMarket`'s cached fields and `Candle` rows are both
/// rebuildable from this table, never the other way around. Idempotency key matches the
/// convention in /docs/SOURCE_OF_TRUTH.md: (chain_id, tx_hash, log_index).
///
/// Also the authoritative source for Phase 2's social activity feed — see docs/SOCIAL.md.
/// A "social activity" item is a read-time projection of a Swap row, never a separate
/// stored copy (`Swap.id` doubles as the activity's stable id).
model Swap {
  id             String   @id @default(uuid())
  chainId        Int      @map("chain_id")
  tokenMarketId  String   @map("token_market_id")
  txHash         String   @map("tx_hash")
  logIndex       Int      @map("log_index")
  blockNumber    BigInt   @map("block_number")
  /// The block's own timestamp, not the time we happened to index it.
  blockTimestamp DateTime @map("block_timestamp")

  /// Raw signed token amounts exactly as the pool reported them (base units, pre-decimals)
  /// — kept for auditability even though `priceUsd`/`volumeUsd` below are what the rest
  /// of the app reads.
  amount0Raw String @map("amount0_raw")
  amount1Raw String @map("amount1_raw")

  /// Pool price immediately after this swap, and this trade's USD value. Computed by us
  /// from the swap's own sqrtPriceX96, never fabricated.
  priceUsd  Decimal @map("price_usd") @db.Decimal(38, 18)
  volumeUsd Decimal @map("volume_usd") @db.Decimal(38, 18)
  /// "buy" or "sell" of `token` (the market's base token), derived from amount sign.
  side      String

  /// The Uniswap V3 Swap event's `recipient` — the address that received this swap's
  /// output tokens. Used as this swap's trader identity (see docs/SOCIAL.md#trader-identity):
  /// for a direct single-hop swap this is the end user's own wallet, but for a multi-hop
  /// route it can be an intermediate router/pool contract instead of the ultimate trader —
  /// a disclosed, deliberate heuristic, not perfect attribution. Nullable because swaps
  /// indexed before Phase 2 predate wallet capture; every swap indexed from Phase 2 onward
  /// has this set.
  traderAddress String? @map("trader_address")
  /// The Uniswap V3 Swap event's `sender` — whichever address called the pool's `swap()`,
  /// almost always a router contract rather than the end user. Kept for audit/future
  /// refinement only; never used as trader identity. Same nullability note as traderAddress.
  senderAddress String? @map("sender_address")

  createdAt DateTime @default(now()) @map("created_at")

  tokenMarket   TokenMarket    @relation(fields: [tokenMarketId], references: [id], onDelete: Restrict)
  trader        Wallet?        @relation(fields: [traderAddress], references: [address], onDelete: SetNull)
  likes         ActivityLike[]
  notifications Notification[]

  @@unique([chainId, txHash, logIndex])
  @@index([tokenMarketId, blockTimestamp])
  /// Trader profile activity + following-feed lookups (`WHERE trader_address = ... ORDER BY
  /// block_timestamp DESC`).
  @@index([traderAddress, blockTimestamp])
  /// Global activity feed cursor pagination (`ORDER BY block_timestamp DESC, id DESC`) — see
  /// docs/SOCIAL.md#pagination.
  @@index([blockTimestamp, id])
  @@map("swaps")
}

/// OHLCV, bucketed at a single raw granularity (see BUCKET_INTERVAL in the ingestion
/// worker) and stored as a Timescale hypertable. Larger chart timeframes are produced by
/// aggregating these buckets at query time (`time_bucket` in the history query), not by
/// pre-materializing every timeframe — see docs/MARKET_DATA.md for why, and the documented
/// upgrade path to continuous aggregates. Rebuildable from `Swap` at any time.
model Candle {
  tokenMarketId String   @map("token_market_id")
  bucketStart   DateTime @map("bucket_start")

  open      Decimal @db.Decimal(38, 18)
  high      Decimal @db.Decimal(38, 18)
  low       Decimal @db.Decimal(38, 18)
  close     Decimal @db.Decimal(38, 18)
  volumeUsd Decimal @map("volume_usd") @db.Decimal(38, 18)

  tokenMarket TokenMarket @relation(fields: [tokenMarketId], references: [id], onDelete: Restrict)

  @@id([tokenMarketId, bucketStart])
  @@map("candles")
}

/// Persistent per-market ingestion progress. The worker never rescans from genesis —
/// it resumes from here, and a crash mid-chunk just means the same range gets fetched
/// again next run (idempotent, thanks to `Swap`'s unique constraint above).
model IngestionCursor {
  tokenMarketId      String   @id @map("token_market_id")
  lastProcessedBlock BigInt   @map("last_processed_block")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tokenMarket TokenMarket @relation(fields: [tokenMarketId], references: [id], onDelete: Cascade)

  @@map("ingestion_cursors")
}

// ---------------------------------------------------------------------------------------
// Phase 2: social layer. See docs/SOCIAL.md for the full architecture. Wallet-first, per
// docs/WALLET_SECURITY.md — a wallet is tracked and has a public trading identity whether
// or not anyone ever signs up; `User` is the optional account layered on top of it.
// ---------------------------------------------------------------------------------------

/// A blockchain address with observed public trading activity — Kamby's "trader," tracked
/// independent of whether anyone has ever signed up (docs/WALLET_SECURITY.md's
/// wallet-first identity model). Rows are created lazily — by the ingestion worker the
/// first time an address appears as a swap's trader, or by Phase 3's wallet-verification
/// flow if a user proves ownership of an address before ever trading (see
/// docs/TRADING.md#wallet-ownership) — never by an unverified user action (following an
/// address that has never traded still 404s, not a phantom profile — see
/// docs/SOCIAL.md#trader-identity). `address` is lowercased for case-insensitive EVM
/// comparisons and doubles as the stable public trader id used in `/trader/[address]`.
///
/// `userId` is set only once a signature has cryptographically proven ownership
/// (`verifiedAt` non-null) — see docs/TRADING.md#wallet-ownership. A `User` may own several
/// verified wallets; a `Wallet` is claimed by at most one `User`. Never trust a client
/// claim that a wallet belongs to the caller — only this column, set exclusively by
/// `WalletService#verifyChallenge`, is authoritative.
///
/// Display identity (`username`/`avatarUrl`) moved to `User` in the realized-PnL/
/// leaderboard phase (see docs/TRADER_INTELLIGENCE.md#realized-pnl) — a `Wallet` never had
/// a write path for its own now-removed `displayName`/`avatarUrl` columns, and a `User`
/// spanning several verified wallets/chains needs exactly one consistent identity, not one
/// per wallet. A `Wallet` with no linked `User` — most of them, per the wallet-first model
/// above — simply has no display identity; `TraderIdentity`'s existing honesty rule
/// (truncated address + an initials avatar, never a fabricated placeholder) already covers
/// that case.
/// Which signature scheme/network a wallet address belongs to — EVM (secp256k1/ECDSA,
/// 0x-hex) or Solana (Ed25519, base58). `Wallet.address` stays a bare, globally-unique
/// `@id` rather than a composite `(chain, address)` key: reshaping the primary key would
/// touch five dependent foreign keys (Follow, Swap, TradeQuote, TradeTransaction,
/// Notification) for a collision risk that's astronomically unlikely in practice (base58
/// and 0x-hex charsets barely overlap) — this column makes the discriminator real and
/// queryable without that blast radius. A genuine cross-chain collision still fails loudly
/// at insert via the existing @id uniqueness, never silently misattributes a wallet.
enum WalletChain {
  EVM
  SOLANA
}

model Wallet {
  address     String      @id
  /// See WalletChain's doc comment. Defaults to EVM since every wallet before this column
  /// existed was, in fact, EVM.
  chain       WalletChain @default(EVM)
  userId      String?     @map("user_id")
  /// The first time Kamby became aware of this wallet in *any* capacity — its first indexed
  /// trade, or the moment a user verified ownership of it, whichever happened first. Never
  /// backdated, never a guess.
  firstSeenAt DateTime    @map("first_seen_at")
  /// Non-null only after a signature has proven this address's owner controls it — see
  /// docs/TRADING.md#wallet-ownership. Null forever for a wallet Kamby has only observed
  /// trading and no one has claimed.
  verifiedAt  DateTime?   @map("verified_at")
  /// Last time this wallet was used for an authenticated action (verification refresh, a
  /// submitted trade) — distinct from `updatedAt`, which also ticks on unrelated field
  /// changes like `displayName`.
  lastUsedAt  DateTime?   @map("last_used_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  user                    User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  trades                  Swap[]
  follows                 Follow[]
  tradeQuotes             TradeQuote[]
  tradeTransactions       TradeTransaction[]
  solanaTradeQuotes       SolanaTradeQuote[]
  solanaTradeTransactions SolanaTradeTransaction[]
  notificationActorFor    Notification[]

  @@unique([chain, address])
  @@index([userId])
  @@map("wallets")
}

/// An authenticated Kamby account — the optional layer on top of Wallet (see
/// docs/WALLET_SECURITY.md). Phase 2 issued only anonymous sessions; Phase 3 adds real
/// wallet ownership (`docs/TRADING.md#wallet-ownership`) on the same session — one `User`
/// can hold several verified `Wallet`s (see the back-relation on `Wallet.userId`), matching
/// a person who uses more than one wallet with Kamby.
model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  /// The realized-PnL/leaderboard phase's identity pair — see
  /// docs/TRADER_INTELLIGENCE.md#realized-pnl and Wallet's own doc comment on why these
  /// moved here rather than staying per-wallet. Both null until the user actually sets
  /// them (the post-verification onboarding prompt is skippable, never forced) — never a
  /// generated fallback; `TraderIdentity.tsx` already has the honest "no identity set yet"
  /// rendering (truncated address + an initials avatar) for exactly this null case.
  /// `username` is validated app-side (length/charset/reserved-word list) before it ever
  /// reaches this column — stored lowercase so the unique constraint is genuinely
  /// case-insensitive (Alice/alice can't both claim it).
  username  String? @unique @db.VarChar(20)
  avatarUrl String? @map("avatar_url")

  /// Phase 6 — see docs/PHASE6_RETENTION_SOCIAL.md#return-loop. Null until the user's
  /// first discover-page visit that calls `POST /discovery/mark-seen`; a plain overwrite on
  /// every call (never a compare-and-swap), which is all "race-safe across multiple browser
  /// sessions" needs here — the last writer simply wins, and every writer is this same
  /// user, so there is no real conflict to resolve, just concurrent writes settling on one
  /// final value.
  lastDiscoverySeenAt DateTime? @map("last_discovery_seen_at")
  /// Consecutive UTC calendar days with at least one `mark-seen` call — see
  /// computeStreak in @kamby/domain for the exact rule. Deliberately the only "engagement"
  /// number in this product — no points, no XP, no badges.
  currentStreakDays   Int       @default(0) @map("current_streak_days")
  longestStreakDays   Int       @default(0) @map("longest_streak_days")

  /// Phase 7 — see docs/REFERRALS.md. Generated once at session creation, permanent for
  /// the life of the row. Unique so a code always resolves to exactly one referrer.
  referralCode     String  @unique @map("referral_code")
  /// Set at most once, only at session creation, only from a code that resolved to a real
  /// user — never overwritten afterward. Null means "not referred," not "referred by
  /// someone since removed" (onDelete: SetNull would otherwise silently reattribute a
  /// user's referral to nobody in a way indistinguishable from never having been referred;
  /// left as the Prisma default — Restrict — so a referrer row can't be deleted while
  /// still credited with referrals, surfacing that conflict instead of hiding it).
  referredByUserId String? @map("referred_by_user_id")
  referredBy       User?   @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals        User[]  @relation("Referrals")

  wallets                 Wallet[]
  follows                 Follow[]
  likes                   ActivityLike[]
  walletChallenges        WalletChallenge[]
  solanaWalletChallenges  SolanaWalletChallenge[]
  tradeQuotes             TradeQuote[]
  tradeTransactions       TradeTransaction[]
  solanaTradeQuotes       SolanaTradeQuote[]
  solanaTradeTransactions SolanaTradeTransaction[]
  notifications           Notification[]           @relation("NotificationRecipient")
  notificationActorFor    Notification[]           @relation("NotificationActorUser")
  notificationPreference  NotificationPreference?
  tokenWatches            TokenWatch[]
  savedSearches           SavedSearch[]
  tokenLots               TokenLot[]
  realizedPnlEvents       RealizedPnlEvent[]
  tokenTheses             TokenThesis[]

  @@map("users")
}

/// A User following a Wallet's public trading activity — the following feed's source of
/// truth. Uniqueness enforced at the DB level so a duplicate follow (double-click, retry)
/// can never produce two rows.
model Follow {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  walletAddress String   @map("wallet_address")
  createdAt     DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet @relation(fields: [walletAddress], references: [address], onDelete: Cascade)

  @@unique([userId, walletAddress])
  /// Follower counts and follower lists for a trader profile (`WHERE wallet_address = ?`).
  @@index([walletAddress])
  @@map("follows")
}

/// A User liking one activity item. An activity item *is* a Swap (see the comment on
/// `Swap` above) — this table adds engagement on top of that authoritative row rather than
/// duplicating it. Uniqueness enforced at the DB level, same reasoning as Follow.
model ActivityLike {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  swapId    String   @map("swap_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  swap Swap @relation(fields: [swapId], references: [id], onDelete: Cascade)

  @@unique([userId, swapId])
  /// Batch like-count lookups for a page of activity items (`WHERE swap_id IN (...)`).
  @@index([swapId])
  @@map("activity_likes")
}

// ---------------------------------------------------------------------------------------
// Phase 3: wallet ownership and trading. See docs/TRADING.md. Non-custodial by
// construction — this schema never has anywhere to put a private key or a signed-on-our-
// behalf transaction; see docs/WALLET_SECURITY.md.
// ---------------------------------------------------------------------------------------

/// A one-time nonce issued to prove ownership of `address` — see
/// docs/TRADING.md#wallet-ownership. Tied to the session that requested it
/// (`userId`, required: only an authenticated session can request a challenge), consumed
/// exactly once (`usedAt`), and time-boxed (`expiresAt`). `message` is stored verbatim so
/// verification recovers a signature against exactly what the wallet was shown — never a
/// re-derived string that could drift from it.
model WalletChallenge {
  id        String    @id @default(uuid())
  address   String
  /// Cryptographically random, unique, single-use — see WalletService#createChallenge.
  nonce     String    @unique
  message   String
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([address])
  @@index([expiresAt])
  @@map("wallet_challenges")
}

/// Solana's counterpart to WalletChallenge, above — kept as a separate model rather than
/// adding a chain branch to the shared one, since the two crypto schemes (Ed25519 here vs.
/// ECDSA/secp256k1 there) verify completely differently, matching this codebase's existing
/// preference for concrete separate classes over one forced-shared abstraction (see
/// TransactionService/SolanaTransactionService in apps/api/src/trading and
/// apps/api/src/solana). No FK to Wallet, same
/// as WalletChallenge — a challenge can be issued for an address no Wallet row exists for
/// yet.
model SolanaWalletChallenge {
  id        String    @id @default(uuid())
  address   String
  /// Cryptographically random, unique, single-use.
  nonce     String    @unique
  message   String
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([address])
  @@index([expiresAt])
  @@map("solana_wallet_challenges")
}

/// A priced, time-boxed offer to swap `inputToken` for `outputToken`, obtained from a real
/// swap aggregator (never invented — see docs/TRADING.md#quote-system) and never mutated
/// after creation. Every token-amount field is the exact raw (pre-decimals) integer as a
/// string — never a JS `number` — so no financial value here is ever subject to
/// floating-point rounding. `unsignedTx` is a prepared, never-signed transaction; the
/// server has no mechanism to sign it — see docs/WALLET_SECURITY.md.
model TradeQuote {
  id            String @id @default(uuid())
  userId        String @map("user_id")
  walletAddress String @map("wallet_address")
  chainId       Int    @map("chain_id")
  /// "BUY" or "SELL" of the tracked market's base token.
  side          String
  tokenMarketId String @map("token_market_id")
  inputToken    String @map("input_token")
  outputToken   String @map("output_token")

  /// Raw integer units (pre-decimals), as strings — see the model comment above.
  inputAmount          String @map("input_amount")
  expectedOutputAmount String @map("expected_output_amount")
  /// The floor `outputAmount` the built transaction actually enforces on-chain, after
  /// `slippageBps` — what "slippage protection" concretely means here.
  minOutputAmount      String @map("min_output_amount")

  priceUsd       Decimal? @map("price_usd") @db.Decimal(38, 18)
  priceImpactBps Int?     @map("price_impact_bps")
  slippageBps    Int      @map("slippage_bps")

  /// Denormalized onto the quote (not just read from live config) so a quote a user reviews
  /// and later signs always executes at the fee it was quoted at — see
  /// docs/TRADING.md#fees.
  platformFeeBps    Int    @map("platform_fee_bps")
  platformFeeAmount String @map("platform_fee_amount")

  /// Which aggregator produced this quote (e.g. "li.fi") — see docs/TRADING.md#provider.
  provider        String
  providerQuoteId String? @map("provider_quote_id")
  /// {to, data, value, gas, maxFeePerGas, maxPriorityFeePerGas} — see
  /// docs/TRADING.md#transaction-construction. Never contains a signature.
  unsignedTx      Json    @map("unsigned_tx")
  /// A second, separate `transfer(feeRecipient, amount)` call moving the platform fee as
  /// plain USDC — present only when this trade's cash side is USDC, see
  /// docs/TRADING.md#guaranteed-usdc-fees. `null` for a trade whose fee still rides along
  /// inside `unsignedTx` via the aggregator's own fee mechanism.
  feeUnsignedTx   Json?   @map("fee_unsigned_tx")

  /// EVM gas relayer consent tracking — see docs/GAS_RELAYER_PLAN.md's EVM section.
  /// Deliberately extends TradeQuote rather than a parallel table: `unsignedTx`,
  /// `walletAddress`, `chainId`, and `expiresAt` above already carry everything the
  /// EIP-712 consent flow needs to reconstruct what the user is being asked to sign, and
  /// duplicating them into a second table would create exactly the "two sources of the
  /// same fact" risk the relayer's whole design goes out of its way to avoid (see
  /// EvmGasRelayerService's own doc comment). True only when this quote was both
  /// requested-as-sponsored AND actually eligible (chain relayer-enabled, wallet
  /// allowlisted if an allowlist is set) — never set from a client's bare request alone.
  sponsorshipRequested Boolean @default(false) @map("sponsorship_requested")
  /// Null until the wallet actually signs the EIP-712 consent object built from this row's
  /// own unsignedTx/expiresAt — see verifyEvmTypedDataSignature (@kamby/chain-adapters).
  relayerConsentSignature String? @map("relayer_consent_signature")
  /// Null whenever sponsorshipRequested is false. Moves PENDING_CONSENT -> CONSENT_RECEIVED
  /// (via a conditional update checked by affected-row count — the guard against a
  /// concurrent duplicate /trade/relay call double-broadcasting) -> BROADCAST, at which
  /// point the real TradeTransaction row (sponsoredByRelayer: true) is the source of truth
  /// for everything downstream; or -> FAILED for a pre-broadcast rejection (simulation
  /// revert, gas-ceiling exceeded, expired consent) that never reaches the chain at all.
  relayerStatus EvmRelayerQuoteStatus? @map("relayer_status")
  /// The nonce the relayer used (or attempted) for this quote's broadcast — diagnostic
  /// only, for manually unsticking a stuck relayer nonce sequence (see
  /// EvmRelayerNonceManagerService's own doc comment on why automatic recovery is
  /// deliberately out of scope for launch). Null until BROADCAST is attempted.
  relayerNonce Int? @map("relayer_nonce")
  /// Set only when relayerStatus is FAILED — why the pre-broadcast simulation/ceiling/
  /// consent check rejected this quote. Never set for a swap that reverted on-chain after
  /// broadcast; that failure lives on the resulting TradeTransaction row instead, same as
  /// every self-paid trade's failureReason.
  relayerFailureReason String? @map("relayer_failure_reason")

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet            @relation(fields: [walletAddress], references: [address], onDelete: Cascade)
  tokenMarket TokenMarket       @relation(fields: [tokenMarketId], references: [id], onDelete: Restrict)
  transaction TradeTransaction?

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("trade_quotes")
}

/// See TradeQuote.relayerStatus's own doc comment for the exact transition rules.
enum EvmRelayerQuoteStatus {
  PENDING_CONSENT
  CONSENT_RECEIVED
  BROADCAST
  FAILED
}

/// A transaction the user's own wallet signed and broadcast — created only once a real
/// transaction hash exists (see docs/TRADING.md#transaction-submission); there is
/// deliberately no row for a quote the user never acted on or a signature the wallet
/// rejected, since neither ever touches the chain. `status` starts at `PENDING` and moves
/// only in response to a real on-chain receipt (or, for `EXPIRED`, giving up after polling
/// for a bounded time) — never set to `CONFIRMED` from a client's say-so. See
/// docs/TRADING.md#transaction-lifecycle.
model TradeTransaction {
  id            String @id @default(uuid())
  userId        String @map("user_id")
  walletAddress String @map("wallet_address")
  quoteId       String @unique @map("quote_id")
  chainId       Int    @map("chain_id")
  txHash        String @map("tx_hash")
  tokenMarketId String @map("token_market_id")
  side          String

  inputToken           String @map("input_token")
  outputToken          String @map("output_token")
  inputAmount          String @map("input_amount")
  expectedOutputAmount String @map("expected_output_amount")
  platformFeeAmount    String @map("platform_fee_amount")

  status        TradeStatus @default(PENDING)
  failureReason String?     @map("failure_reason")

  /// True only for a transaction EvmGasRelayerService itself broadcast (the relayer paid
  /// the network fee) — false for every self-paid trade, which is still the entire
  /// launch-scope flow. Mirrors SolanaTradeTransaction.sponsoredByRelayer exactly — see
  /// docs/GAS_RELAYER_PLAN.md's EVM section. This column exists ahead of the relayer
  /// actually being enabled on any deployment, same "shovel-ready before it's live"
  /// pattern the Solana relayer's own schema work already followed.
  sponsoredByRelayer Boolean @default(false) @map("sponsored_by_relayer")
  /// The relayer's own address at the time this transaction was sponsored — null whenever
  /// sponsoredByRelayer is false. Recorded per-row (not just read from current env config)
  /// so history stays accurate even after a relayer key rotation.
  relayerFeePayer String? @map("relayer_fee_payer")

  /// The separate USDC fee-transfer transaction — see docs/TRADING.md#guaranteed-usdc-fees.
  /// `feeTxHash` stays null until the wallet actually submits it (never required for the
  /// swap above to be considered done); `feeStatus` follows the same PENDING → CONFIRMED /
  /// FAILED / EXPIRED lifecycle as `status`, tracked independently — a confirmed swap with
  /// a still-pending (or never-submitted) fee transfer is a fully successful trade from the
  /// user's side, just one Kamby hasn't collected its fee on yet.
  feeTxHash        String?      @map("fee_tx_hash")
  feeStatus        TradeStatus? @map("fee_status")
  feeFailureReason String?      @map("fee_failure_reason")
  feeSubmittedAt   DateTime?    @map("fee_submitted_at")
  feeConfirmedAt   DateTime?    @map("fee_confirmed_at")

  submittedAt    DateTime  @default(now()) @map("submitted_at")
  confirmedAt    DateTime? @map("confirmed_at")
  /// Realized-PnL sweep marker — see docs/TRADER_INTELLIGENCE.md#realized-pnl and
  /// PnlLedgerSweepService's own doc comment. Null means "not yet swept" (regardless of
  /// `status` — a PENDING/FAILED/EXPIRED row is swept too, just skipped with no lot/event
  /// created, so the sweep's WHERE clause never has to special-case the terminal statuses
  /// separately). Set exactly once, never cleared.
  pnlProcessedAt DateTime? @map("pnl_processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet             @relation(fields: [walletAddress], references: [address], onDelete: Cascade)
  quote             TradeQuote         @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  tokenMarket       TokenMarket        @relation(fields: [tokenMarketId], references: [id], onDelete: Restrict)
  tokenLot          TokenLot?
  realizedPnlEvents RealizedPnlEvent[]

  @@unique([chainId, txHash])
  @@unique([chainId, feeTxHash])
  @@index([userId, createdAt])
  @@index([status])
  @@index([feeStatus])
  @@index([status, pnlProcessedAt])
  @@map("trade_transactions")
}

/// See the status-transition comment on TradeTransaction above.
enum TradeStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

/// Solana's counterpart to TradeQuote — same "never mutated after creation, every amount a
/// raw-integer string, never a JS number" discipline (see docs/TRADING.md#quote-system).
/// Kept fully separate from TradeQuote rather than a shared polymorphic table — mints
/// instead of EVM token addresses, no tokenMarketId (Solana trading isn't backed by
/// Kamby's own market-discovery/ingestion pipeline, just a direct Jupiter quote for
/// whatever mint the user is swapping). No fee-payer field yet: launch ships
/// non-custodial — the user's own wallet pays its own gas — see
/// docs/WALLET_SECURITY.md's Solana section. A fee-payer column lands in a later
/// migration alongside the (deferred) gasless relayer, not spec'd here ahead of need.
model SolanaTradeQuote {
  id            String @id @default(uuid())
  userId        String @map("user_id")
  walletAddress String @map("wallet_address")
  /// "BUY" or "SELL", same convention as TradeQuote.side.
  side          String
  inputMint     String @map("input_mint")
  outputMint    String @map("output_mint")

  /// Raw integer units (pre-decimals), as strings — see the model comment above.
  inputAmount          String @map("input_amount")
  expectedOutputAmount String @map("expected_output_amount")
  minOutputAmount      String @map("min_output_amount")

  priceUsd       Decimal? @map("price_usd") @db.Decimal(38, 18)
  priceImpactBps Int?     @map("price_impact_bps")
  slippageBps    Int      @map("slippage_bps")

  /// Denormalized onto the quote, same reasoning as TradeQuote: a quote a user reviews and
  /// later signs always executes at the fee it was quoted at.
  platformFeeBps    Int    @map("platform_fee_bps")
  platformFeeAmount String @map("platform_fee_amount")

  /// Jupiter's own quote id, if any, plus the serialized (never signed) swap transaction it
  /// returned — see docs/WALLET_SECURITY.md.
  providerQuoteId String? @map("provider_quote_id")
  unsignedTx      Json    @map("unsigned_tx")

  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet      Wallet                  @relation(fields: [walletAddress], references: [address], onDelete: Cascade)
  transaction SolanaTradeTransaction?

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("solana_trade_quotes")
}

/// Solana's counterpart to TradeTransaction — created only once a real signature exists;
/// `status` moves only in response to a real on-chain confirmation, never a client's
/// say-so. No feeTxHash/feeStatus pair: the guaranteed-USDC separate-fee-transfer flow is
/// an EVM-specific mechanism (see TradeTransaction's own comment) — Jupiter's fee is
/// deducted atomically inside the swap itself via platformFeeBps/feeAccount, so there is no
/// second transaction to track here.
model SolanaTradeTransaction {
  id            String @id @default(uuid())
  userId        String @map("user_id")
  walletAddress String @map("wallet_address")
  quoteId       String @unique @map("quote_id")
  signature     String @unique
  side          String

  inputMint            String @map("input_mint")
  outputMint           String @map("output_mint")
  inputAmount          String @map("input_amount")
  expectedOutputAmount String @map("expected_output_amount")
  platformFeeAmount    String @map("platform_fee_amount")

  status        TradeStatus @default(PENDING)
  failureReason String?     @map("failure_reason")

  /// True only for a transaction GasRelayerService itself broadcast (the relayer paid the
  /// network fee) — false for every self-paid trade, which is still the entire launch-scope
  /// flow. See docs/GAS_RELAYER_PLAN.md; this column exists ahead of the relayer actually
  /// being enabled on any deployment, same "shovel-ready before it's live" pattern the rest
  /// of that design already follows.
  sponsoredByRelayer Boolean @default(false) @map("sponsored_by_relayer")
  /// The relayer's fee-payer public key at the time this transaction was sponsored — null
  /// whenever sponsoredByRelayer is false. Recorded per-row (not just read from current env
  /// config) so history stays accurate even after a relayer keypair rotation.
  relayerFeePayer    String? @map("relayer_fee_payer")

  submittedAt    DateTime  @default(now()) @map("submitted_at")
  confirmedAt    DateTime? @map("confirmed_at")
  /// See TradeTransaction.pnlProcessedAt's own doc comment — identical rule, Solana side.
  pnlProcessedAt DateTime? @map("pnl_processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet             @relation(fields: [walletAddress], references: [address], onDelete: Cascade)
  quote             SolanaTradeQuote   @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  tokenLot          TokenLot?
  realizedPnlEvents RealizedPnlEvent[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([status, pnlProcessedAt])
  @@map("solana_trade_transactions")
}

// ---------------------------------------------------------------------------------------
// Realized PnL — see docs/TRADER_INTELLIGENCE.md#realized-pnl for the full methodology
// (scope, FIFO rules, disclosed approximations). Scoped to Kamby-originated trades only
// (TradeTransaction / SolanaTradeTransaction), computed asynchronously by apps/workers'
// PnlLedgerSweepService — never synchronously in the same flow that confirms a trade (see
// that service's own doc comment for why: 4 independent call sites across 2 runtimes
// already flip a trade to CONFIRMED, and apps/workers runs one replica per chain by
// design, neither of which this sweep can assume). Both models below are immutable-append
// ledgers — a row, once written, is never mutated except TokenLot.quantityRemainingRaw
// ticking down as later sells consume it — matching TradeQuote's own
// never-mutated-after-creation discipline.
// ---------------------------------------------------------------------------------------

/// One CONFIRMED BUY's worth of a token not yet (fully) consumed by a later SELL — the
/// FIFO queue realized-PnL matching draws from, oldest `acquiredAt` first. Exactly one of
/// `evmTokenId`/`solanaMint` is set, matching `chain`; exactly one of
/// `evmBuyTransactionId`/`solanaBuyTransactionId` is set — the same
/// never-force-unify-EVM-and-Solana convention `SolanaTradeQuote`'s own doc comment
/// explains (mints vs. EVM addresses, no shared polymorphic table). Enforced app-side, not
/// a DB constraint, matching how every other dual-nullable-FK pair in this schema already
/// works. Never deleted — a fully-consumed lot (`quantityRemainingRaw` = "0") stays for
/// audit/history.
model TokenLot {
  id     String      @id @default(uuid())
  userId String      @map("user_id")
  chain  WalletChain

  /// FK to Token (the fungibility unit), never TokenMarket — one token can trade through
  /// several pools/markets at once (see TokenMarket's own doc comment); keying a lot by
  /// market would silently fragment one real balance into non-matching pools the moment a
  /// user's buy and sell route through different pools for the same token.
  evmTokenId String? @map("evm_token_id")
  solanaMint String? @map("solana_mint")

  evmBuyTransactionId    String? @unique @map("evm_buy_transaction_id")
  solanaBuyTransactionId String? @unique @map("solana_buy_transaction_id")

  /// Raw integer units (pre-decimals), as strings — see TradeQuote's own model comment on
  /// why every token amount in this codebase is a string, never a JS number.
  quantityOriginalRaw  String   @map("quantity_original_raw")
  quantityRemainingRaw String   @map("quantity_remaining_raw")
  /// Total USD cost of `quantityOriginalRaw` at acquisition, priced off the BUY's own
  /// quote (quote-time, not settlement-time — see docs/TRADER_INTELLIGENCE.md#realized-pnl
  /// for why this is a disclosed approximation, not a guess). A BUY whose quote had a null
  /// `priceUsd` never gets a lot created for it at all — see PnlLedgerSweepService.
  costBasisUsd         Decimal  @map("cost_basis_usd") @db.Decimal(38, 18)
  acquiredAt           DateTime @map("acquired_at")

  createdAt DateTime @default(now()) @map("created_at")

  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  evmToken             Token?                  @relation(fields: [evmTokenId], references: [id], onDelete: Restrict)
  evmBuyTransaction    TradeTransaction?       @relation(fields: [evmBuyTransactionId], references: [id], onDelete: Restrict)
  solanaBuyTransaction SolanaTradeTransaction? @relation(fields: [solanaBuyTransactionId], references: [id], onDelete: Restrict)
  realizedPnlEvents    RealizedPnlEvent[]

  @@index([userId, chain, evmTokenId])
  @@index([userId, chain, solanaMint])
  @@map("token_lots")
}

/// One FIFO-matched portion of a CONFIRMED SELL against one `TokenLot` — a SELL that
/// consumes several lots produces several rows here, one per lot. Any sold quantity beyond
/// what this user has a recorded open lot for is excluded entirely, never matched against
/// nothing and counted as free profit — see docs/TRADER_INTELLIGENCE.md#realized-pnl.
/// `confirmedAt` is copied from the sell transaction; every rolling-window (24h/7d/30d)
/// leaderboard/profile query filters on this column, never recomputes it from a join.
model RealizedPnlEvent {
  id     String      @id @default(uuid())
  userId String      @map("user_id")
  chain  WalletChain

  evmTokenId String? @map("evm_token_id")
  solanaMint String? @map("solana_mint")

  lotId                   String  @map("lot_id")
  evmSellTransactionId    String? @map("evm_sell_transaction_id")
  solanaSellTransactionId String? @map("solana_sell_transaction_id")

  /// Raw integer units, as a string — see TokenLot's own comment.
  quantityMatchedRaw String   @map("quantity_matched_raw")
  /// The matched portion's share of the lot's cost basis — i.e.
  /// `quantityMatchedRaw / lot.quantityOriginalRaw * lot.costBasisUsd`, computed once at
  /// match time and stored, never recomputed from a join.
  costBasisUsd       Decimal  @map("cost_basis_usd") @db.Decimal(38, 18)
  /// The matched portion's share of the sell's proceeds, priced off the SELL's own quote
  /// (same quote-time-price disclosed approximation as TokenLot.costBasisUsd). A SELL
  /// whose quote had a null `priceUsd` never produces a RealizedPnlEvent at all.
  proceedsUsd        Decimal  @map("proceeds_usd") @db.Decimal(38, 18)
  /// = proceedsUsd - costBasisUsd, stored rather than always recomputed — this is the
  /// figure every leaderboard/profile aggregate sums.
  realizedPnlUsd     Decimal  @map("realized_pnl_usd") @db.Decimal(38, 18)
  confirmedAt        DateTime @map("confirmed_at")

  createdAt DateTime @default(now()) @map("created_at")

  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  evmToken              Token?                  @relation(fields: [evmTokenId], references: [id], onDelete: Restrict)
  lot                   TokenLot                @relation(fields: [lotId], references: [id], onDelete: Restrict)
  evmSellTransaction    TradeTransaction?       @relation(fields: [evmSellTransactionId], references: [id], onDelete: Restrict)
  solanaSellTransaction SolanaTradeTransaction? @relation(fields: [solanaSellTransactionId], references: [id], onDelete: Restrict)

  @@unique([evmSellTransactionId, lotId])
  @@unique([solanaSellTransactionId, lotId])
  @@index([userId, confirmedAt])
  @@map("realized_pnl_events")
}

/// A trader's own short note on why they're holding a token — shown alongside their
/// position in the token's Holders table. One thesis per user per token, editable in
/// place (a plain upsert, not a history) — a live opinion, not an append-only ledger like
/// TokenLot/RealizedPnlEvent above. Same exactly-one-of-evmTokenId/solanaMint convention as
/// TokenLot, keyed by Token (not TokenMarket) for the same reason given there: a thesis is
/// about the token, not one specific pool.
model TokenThesis {
  id     String      @id @default(uuid())
  userId String      @map("user_id")
  chain  WalletChain

  evmTokenId String? @map("evm_token_id")
  solanaMint String? @map("solana_mint")

  /// Capped app-side before it ever reaches this column — see CreateThesisSchema in
  /// @kamby/domain (280 chars, matching the UI's own limit).
  text String @db.VarChar(280)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  evmToken Token? @relation(fields: [evmTokenId], references: [id], onDelete: Cascade)

  @@unique([userId, chain, evmTokenId])
  @@unique([userId, chain, solanaMint])
  @@index([chain, evmTokenId])
  @@index([chain, solanaMint])
  @@map("token_theses")
}

// ---------------------------------------------------------------------------------------
// Phase 4: notifications. See docs/NOTIFICATIONS.md. Postgres is the sole source of truth
// for every notification — Redis/SSE (below) is realtime *delivery* only, never storage;
// a notification is always persisted before it is ever published, so a Redis or SSE outage
// can degrade how fast a user finds out, never whether the notification exists at all.
// ---------------------------------------------------------------------------------------

enum NotificationType {
  FOLLOW
  LIKE
  FOLLOWED_TRADER_TRADE
  WHALE_TRADE
  TRENDING_TOKEN
  /// Phase 6 — see docs/PHASE6_RETENTION_SOCIAL.md#notification-integration. A large trade
  /// in a token the recipient is *watching* (TokenWatch), scoped to watchers who aren't
  /// already covered by WHALE_TRADE (past traders of that token) — see the fan-out comment
  /// in NotificationFanoutService#notifyWatchedTokenActivity for why those two recipient
  /// sets are deliberately disjoint. Never fired for every swap — same threshold + cooldown
  /// discipline as WHALE_TRADE.
  WATCHED_TOKEN_ACTIVITY
}

/// One notification for `user` (the recipient — always resolved from the authenticated
/// session server-side, never a client-supplied id; see docs/NOTIFICATIONS.md#security).
/// Deliberately stores only references, never a precomputed title/body/deep-link string —
/// those are derived at read time from the referenced rows (see
/// docs/SOURCE_OF_TRUTH.md and the NotificationDto comment in @kamby/domain), the same
/// "read-time projection" pattern `Swap` → social-activity already uses.
///
/// `actorUserId`/`actorWalletAddress` are two different flavors of "who caused this,"
/// populated depending on `type` (see NOTIFICATION_PREFERENCE_FIELD in @kamby/domain):
/// FOLLOW/LIKE reference the acting *User* (a follow/like is a session action, and the
/// actor may not even have a wallet yet); FOLLOWED_TRADER_TRADE/WHALE_TRADE reference the
/// acting *Wallet* (the trader who made the swap, which is a wallet-level fact). Both are
/// nullable and never both populated for the same row. TRENDING_TOKEN has no actor at all.
///
/// `dedupeKey` + the unique constraint below is the idempotency guarantee required by
/// docs/NOTIFICATIONS.md#idempotency — every creation path (API for follow/like, worker
/// for trade/whale/trending) must build its key with the matching helper in
/// @kamby/domain/notifications so retries, indexer re-runs, and concurrent workers can never
/// create a duplicate, without relying on any in-memory dedup.
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  dedupeKey String           @map("dedupe_key")

  actorUserId        String? @map("actor_user_id")
  actorWalletAddress String? @map("actor_wallet_address")
  swapId             String? @map("swap_id")
  tokenMarketId      String? @map("token_market_id")

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user        User         @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorUser   User?        @relation("NotificationActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorWallet Wallet?      @relation(fields: [actorWalletAddress], references: [address], onDelete: SetNull)
  swap        Swap?        @relation(fields: [swapId], references: [id], onDelete: SetNull)
  tokenMarket TokenMarket? @relation(fields: [tokenMarketId], references: [id], onDelete: SetNull)

  /// The idempotency guarantee itself — see the model comment above.
  @@unique([userId, type, dedupeKey])
  /// The notification list, newest first (`WHERE user_id = ? ORDER BY created_at DESC`).
  @@index([userId, createdAt])
  /// Unread count and unread list (`WHERE user_id = ? AND read_at IS NULL`).
  @@index([userId, readAt])
  /// Related-entity lookups (e.g. "did this swap/token already notify anyone").
  @@index([swapId])
  @@index([tokenMarketId])
  @@map("notifications")
}

/// Per-user opt-out toggles — see docs/NOTIFICATIONS.md#preferences. No row means "every
/// default applies" (see NOTIFICATION_DEFAULTS.preferenceDefaults in @kamby/domain); a row
/// is created lazily on first write, not eagerly for every signup, matching this schema's
/// "don't duplicate data unnecessarily" convention elsewhere. Read and written only via the
/// authenticated session's own `userId` — never a client-supplied id, and never trusted for
/// authorization (a disabled preference stops *creation* of a new notification of that
/// type; it is not a security boundary and grants no access to anything).
model NotificationPreference {
  userId               String   @id @map("user_id")
  follows              Boolean  @default(true)
  likes                Boolean  @default(true)
  followedTraderTrades Boolean  @default(true) @map("followed_trader_trades")
  whaleTrades          Boolean  @default(true) @map("whale_trades")
  trendingTokens       Boolean  @default(true) @map("trending_tokens")
  /// Phase 6 — gates WATCHED_TOKEN_ACTIVITY, same opt-out-by-default convention as every
  /// other preference here.
  watchedTokenActivity Boolean  @default(true) @map("watched_token_activity")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Whether each token market is *currently* trending per `computeTrendingScore` (see
/// @kamby/domain/social) — tracked purely so the worker can detect a false→true transition
/// and notify only on genuine entry into trending, never on every tick's score fluctuation
/// (docs/NOTIFICATIONS.md#trending-tokens). Never a second trending algorithm or a stored
/// score: this table is a rebuildable cache of one boolean, derived the same way
/// `TokenMarket`'s own cached fields are — recomputable from current data at any time.
model TokenTrendingState {
  tokenMarketId    String    @id @map("token_market_id")
  isTrending       Boolean   @default(false) @map("is_trending")
  /// Set when `isTrending` last flipped false→true; this is what makes the dedupe key for
  /// the resulting notification (see trendingTokenDedupeKey in @kamby/domain) unique to that
  /// specific entry into trending, so a later re-entry can notify again.
  becameTrendingAt DateTime? @map("became_trending_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tokenMarket TokenMarket @relation(fields: [tokenMarketId], references: [id], onDelete: Cascade)

  @@map("token_trending_state")
}

/// Phase 6 — see docs/PHASE6_RETENTION_SOCIAL.md#watchlists. A user "watching" a token
/// market; the row's mere existence is the fact (no extra state). Keyed by tokenMarketId,
/// not a raw token id, matching every other per-token-market state table (Notification,
/// TokenTrendingState, TradeQuote) rather than the illustrative field name in the spec.
/// Add/remove is idempotent via the unique constraint below — see WatchlistService, which
/// treats a P2002 on create as a successful no-op rather than an error, the same pattern
/// Follow and ActivityLike already use.
model TokenWatch {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  tokenMarketId String   @map("token_market_id")
  createdAt     DateTime @default(now()) @map("created_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenMarket TokenMarket @relation(fields: [tokenMarketId], references: [id], onDelete: Cascade)

  /// Enforces idempotent watch/unwatch and is what a repeat "watch" call relies on.
  @@unique([userId, tokenMarketId])
  /// Serves "my watchlist, newest first" (GET /social/watchlist).
  @@index([userId, createdAt])
  /// Serves the bounded fan-out query in NotificationFanoutService#notifyWatchedTokenActivity
  /// and the aggregate watched-by count on a token's detail page.
  @@index([tokenMarketId])
  @@map("token_watches")
}

/// Phase 6 — see docs/PHASE6_RETENTION_SOCIAL.md#saved-searches. A lightweight bookmark of a
/// discovery/market query string, nothing more — no stored result set, no scheduled re-run,
/// no analytics. `SavedSearchService` enforces a max-per-user cap (see MAX_SAVED_SEARCHES in
/// @kamby/domain) at the service layer rather than in the schema, the same way other
/// business-rule bounds in this codebase are enforced above the DB.
model SavedSearch {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  query       String
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Serves "my saved searches, newest first" and the per-user count check backing the cap.
  @@index([userId, createdAt])
  @@map("saved_searches")
}

/// A Solana token launched via Pump.fun's bonding-curve program — see
/// docs/TRADING.md#pump-fun-trenches for the verified program ID/account layout this
/// mirrors. Deliberately a separate model from Token/TokenMarket rather than forced into
/// their EVM-shaped columns (a numeric chainId, pairAddress/dex/feeTier — concepts that
/// don't exist for a bonding curve) — same "concrete separate classes over one forced-
/// shared abstraction" precedent as SolanaTradeQuote/SolanaTradeTransaction being separate
/// from their EVM TradeQuote/TradeTransaction counterparts.
///
/// Reserve/supply fields are raw on-chain u64 values, stored as strings — same "never a
/// native numeric type for a raw token amount" discipline every other money-shaped field in
/// this schema already follows (see TradeQuote/SolanaTradeQuote), not because u64 can't fit
/// a Postgres BIGINT for realistic pump.fun values, but for consistency and to foreclose the
/// precision-loss risk class entirely. This table is a faithful on-chain mirror, refreshed
/// by the ingestion worker exactly as read from the BondingCurve account — never an
/// opinionated cache; computing price/graduation-progress from these is the reader's job
/// (see token-trenches.service.ts).
model PumpFunToken {
  id                  String  @id @default(uuid())
  mintAddress         String  @unique @map("mint_address")
  bondingCurveAddress String  @unique @map("bonding_curve_address")
  creatorAddress      String? @map("creator_address")

  /// From the create instruction's own logged args — nullable until observed, same
  /// "never fabricate metadata the indexer hasn't confirmed" rule as Token.symbol/name.
  name   String?
  symbol String?
  uri    String?

  virtualTokenReserves String  @map("virtual_token_reserves")
  virtualSolReserves   String  @map("virtual_sol_reserves")
  realTokenReserves    String  @map("real_token_reserves")
  realSolReserves      String  @map("real_sol_reserves")
  tokenTotalSupply     String  @map("token_total_supply")
  /// Mirrors the BondingCurve account's own `complete` flag exactly — true once migrated
  /// to PumpSwap. Never independently inferred (e.g. never "realTokenReserves == '0'"
  /// computed here) — the account's own flag is the single source of truth.
  complete             Boolean @default(false)

  createdAt         DateTime  @default(now()) @map("created_at")
  /// When the reserve fields above were last refreshed from a real on-chain read/log — the
  /// basis for a "stale" UI state, same convention as TokenMarket.lastPriceUpdateAt.
  lastStateUpdateAt DateTime  @map("last_state_update_at")
  /// Set once, the first time `complete` is observed true — never recomputed afterward.
  /// JUST_GRADUATED reads this for its own recency window, not updatedAt (which changes on
  /// every subsequent state refresh, graduated or not).
  graduatedAt       DateTime? @map("graduated_at")

  /// Serves FRESH (complete = false, ordered by createdAt) and NEAR_GRADUATED (complete =
  /// false, ordered by realSolReserves) — see token-trenches.service.ts.
  @@index([complete, createdAt])
  /// Serves JUST_GRADUATED — complete = true, newest graduation first.
  @@index([graduatedAt])
  @@map("pump_fun_tokens")
}

/// Established Solana tokens (real Raydium/Orca liquidity — BONK/WIF/JUP-class, distinct
/// from Pump.fun's pre-graduation bonding-curve tokens above) shown in the Markets/
/// Trending/Movers/Volume tabs alongside TokenMarket's EVM rows. A deliberate, separate
/// concrete model rather than forced into TokenMarket — same "concrete separate types over
/// one forced-shared abstraction" precedent as PumpFunToken above; TokenMarket's feeTier/
/// pairAddress-as-pool-contract shape and its whole ingestion pipeline are Uniswap-V3-
/// specific and don't fit a Solana AMM at all.
///
/// A genuine, deliberate exception to this codebase's usual rule (see TokenMarket.volume24hUsd's
/// own comment: "not borrowed from a third party"): there is no on-chain equivalent to
/// UniswapV3PoolReader's slot0()-style read across arbitrary Solana AMM programs without
/// picking one (e.g. Raydium) and building real ingestion for it — a much bigger project,
/// deliberately deferred. DexScreener's public API is the actual source of truth here for
/// price/liquidity/volume, not just used for discovery — confirmed and accepted 2026-09-24
/// as the pragmatic tradeoff for shipping this now.
model SolanaTokenMarket {
  id          String  @id @default(uuid())
  mintAddress String  @unique @map("mint_address")

  /// From DexScreener's own token metadata — nullable until a first successful poll, never
  /// fabricated, same convention as Token.symbol/name.
  symbol   String?
  name     String?
  decimals Int?
  logoUrl  String? @map("logo_url")

  /// The pair's quote token (e.g. SOL's own mint) — always present once a pool is found,
  /// same "always present" guarantee TokenMarket.quoteTokenId gives MarketSummary.quoteAddress.
  quoteMintAddress String  @map("quote_mint_address")
  quoteSymbol      String? @map("quote_symbol")
  dex              String?

  priceUsd          Decimal?  @map("price_usd") @db.Decimal(38, 18)
  liquidityUsd      Decimal?  @map("liquidity_usd") @db.Decimal(38, 18)
  volume24hUsd      Decimal?  @map("volume_24h_usd") @db.Decimal(38, 18)
  priceChange24hPct Decimal?  @map("price_change_24h_pct") @db.Decimal(12, 4)
  marketCapUsd      Decimal?  @map("market_cap_usd") @db.Decimal(38, 2)
  lastPriceUpdateAt DateTime? @map("last_price_update_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([liquidityUsd])
  @@map("solana_token_markets")
}
