# Copy to .env.local for local development.

NODE_ENV=development

# Server-only (see lib/env.ts) — the API's address, never sent to the browser.
API_BASE_URL=http://localhost:4000

# Browser-facing (see lib/env.ts's ClientEnvSchema) — the one deliberate exception, needed
# for the live activity SSE connection and follow/like mutations. Same API, public URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Phase 3 wallet/trading — see docs/TRADING.md. Must name the same chain apps/api's
# CHAIN_ID does.
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_CHAIN_RPC_URL=https://mainnet.base.org
# Optional — enables WalletConnect for mobile wallets in addition to injected/Coinbase
# Wallet. Get one at https://cloud.reown.com. Leave unset to omit WalletConnect entirely.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional — BNB Chain is already a recognized network in lib/wagmi-config.ts's `chains`
# list (unlike Arbitrum, which isn't wired into the frontend at all yet — see the note in
# docs/MULTICHAIN_OCTOBER_PLAN.md). Leaving this unset is NOT "half-configured": wagmi
# falls back to BNB Chain's own public default RPC automatically (confirmed via viem's
# actual `http()` transport source). Set a dedicated provider URL here only to move off
# that public default once real traffic justifies it. This alone does not turn ON BNB
# trading — that's apps/api's CHAINS var; this only affects whether a wallet already on
# BNB Chain is recognized instead of shown as "Wrong network."
# NEXT_PUBLIC_CHAIN_BNB_RPC_URL=https://bsc-dataseed.binance.org

# Solana trading — see docs/TRADING.md#solana. All three travel together: when any is
# missing, the Solana trading UI simply doesn't render rather than half-initializing.
# Get a Privy app ID at https://dashboard.privy.io.
NEXT_PUBLIC_PRIVY_APP_ID=
# The browser reads from this directly (balance checks, confirmation polling) and Privy's
# embedded-wallet hooks build their own RPC client from it — never put apps/api's own
# SOLANA_RPC_URL key here: NEXT_PUBLIC_* vars are inlined into the public JS bundle, so any
# key here ships to every browser. The fully public api.mainnet-beta.solana.com endpoint
# was tried first and is NOT recommended — it's too unreliable for Privy's own browser-side
# transaction simulation/confirmation (real trades failed with "error preparing your
# transaction"). Use a separate, dedicated Helius (or similar) key instead — scoped to
# browser traffic only, so it never shares a quota with the backend's own trading-critical
# key, but still a real key with real rate limits rather than the shared public endpoint.
NEXT_PUBLIC_SOLANA_RPC_URL=
# Where a signed transaction broadcasts when the user opts into a Jito tip (see
# SolanaTradePanel.tsx's signAndBroadcastViaJito) — defaults to the real mainnet endpoint,
# only set this to point at a specific regional Block Engine cluster instead.
# NEXT_PUBLIC_JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions
