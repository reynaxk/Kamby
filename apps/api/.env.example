# Copy to .env for local development (docker compose up -d provides matching defaults).
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://kamby:kamby@localhost:5432/kamby?schema=public
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Generate a real one for anything beyond local dev: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-before-deploying

# Phase 3 trading, multi-chain — see docs/TRADING.md#chain-scope. Which chains this
# deployment trades on; each slug named here needs its own CHAIN_<SLUG>_* block below fully
# populated (checked at boot). Must name the same chains apps/workers/.env.example's
# CHAIN_<SLUG>_IDENTIFIER entries already index.
CHAINS=base
# Which of CHAINS a request that omits chainId resolves to.
DEFAULT_CHAIN_SLUG=base

CHAIN_BASE_ID=8453
CHAIN_BASE_RPC_URL=https://mainnet.base.org
# This chain's USDC contract — see docs/TRADING.md#guaranteed-usdc-fees. Must name the same
# token as apps/workers/.env.example's matching CHAIN_BASE_USDC_ADDRESS. The real Base USDC
# address below.
CHAIN_BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Uncomment to enable Arbitrum too (and add "arbitrum" to CHAINS above):
# CHAIN_ARBITRUM_ID=42161
# CHAIN_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# CHAIN_ARBITRUM_USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# MetaAggregatorSwapRouter races LI.FI and 1inch in parallel for every quote and takes
# whichever prices more output — both keys below are required, not an either/or. See
# docs/TRADING.md#provider. Without a key, that provider's leg of the race is honestly
# skipped rather than falling back to an invented price; if both are missing/invalid,
# quotes fail entirely.
# Free tier at https://portal.li.fi.
LIFI_API_KEY=replace-with-a-real-lifi-api-key
# The integrator identity registered at https://portal.li.fi. LI.FI pays the platform fee
# to whatever wallet is configured there under this name — PLATFORM_FEE_RECIPIENT_ADDRESS
# below must match what's actually registered in that portal, or fees go nowhere useful.
LIFI_INTEGRATOR=replace-with-your-registered-lifi-integrator-name
# Free tier at https://business.1inch.com (100k calls/month).
ONEINCH_API_KEY=replace-with-a-real-1inch-api-key
# The wallet address that receives the platform fee — collected atomically by the swap
# transaction itself, never custodied by this backend in between. Must match the wallet
# registered for LIFI_INTEGRATOR above.
PLATFORM_FEE_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000
# 50 = 0.50% — see docs/TRADING.md#fees.
PLATFORM_FEE_BPS=50

# Solana trading — see docs/TRADING.md#solana and docs/WALLET_SECURITY.md's Solana
# section. Off by default; every SOLANA_* var below is only required once this is true.
SOLANA_ENABLED=false
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# A USDC Associated Token Account owned by the treasury — NOT the treasury's raw wallet
# address. Jupiter's feeAccount must be a token account for the swap's own mint.
# SOLANA_TREASURY_USDC_ATA=replace-with-a-real-usdc-ata
# 50 = 0.50%, matches the EVM side.
SOLANA_JUPITER_PLATFORM_FEE_BPS=50
# How much SOL a brand-new embedded wallet gets once, on creation, so it doesn't feel
# broken even though (launch scope) the wallet pays its own gas after that.
SOLANA_NEW_WALLET_TOPUP_SOL=0.01
# A small, separately-funded operational keypair (base58 secret key) that only ever sends
# that one fixed top-up transfer — never the (not yet built) gasless-relayer fee-payer key.
# SOLANA_TOPUP_FUNDING_SECRET_KEY=replace-with-a-real-base58-secret-key
# Required by Jupiter even on its free tier (1 req/sec) — their old keyless domain
# (quote-api.jup.ag) stopped resolving in production on 2026-09-12; the current API at
# api.jup.ag requires this header on every call. Get one at https://portal.jup.ag.
# SOLANA_JUPITER_API_KEY=replace-with-a-real-jupiter-api-key
