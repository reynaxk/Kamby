# Copy to .env for local development (docker compose up -d provides matching defaults).
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://kamby:kamby@localhost:5432/kamby?schema=public
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Generate a real one for anything beyond local dev: openssl rand -base64 32
JWT_SECRET=dev-only-secret-change-me-before-deploying

# Phase 3 trading, multi-chain — see docs/TRADING.md#chain-scope. Which chains this
# deployment trades on; each slug named here needs its own CHAIN_<SLUG>_* block below fully
# populated (checked at boot). Must name the same chains apps/workers/.env.example's
# CHAIN_<SLUG>_IDENTIFIER entries already index.
CHAINS=base
# Which of CHAINS a request that omits chainId resolves to.
DEFAULT_CHAIN_SLUG=base

CHAIN_BASE_ID=8453
CHAIN_BASE_RPC_URL=https://mainnet.base.org
# Optional second RPC endpoint — see docs/TRADING.md#rpc-failover. Recommended: QuickNode's
# Base RPC has already exhausted its daily quota once in production with no fallback
# configured. Uncomment and point at a second provider (or a public endpoint) once you have one.
# CHAIN_BASE_RPC_URL_FALLBACK=https://mainnet.base.org
# This chain's USDC contract — see docs/TRADING.md#guaranteed-usdc-fees. Must name the same
# token as apps/workers/.env.example's matching CHAIN_BASE_USDC_ADDRESS. The real Base USDC
# address below.
CHAIN_BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Uncomment to enable Arbitrum too (and add "arbitrum" to CHAINS above):
# CHAIN_ARBITRUM_ID=42161
# CHAIN_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# CHAIN_ARBITRUM_RPC_URL_FALLBACK=https://arbitrum.llamarpc.com
# CHAIN_ARBITRUM_USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# Uncomment to enable BNB Chain too (and add "bnb" to CHAINS above). Priced via OpenOcean,
# not KyberSwap — see docs/TRADING.md#provider and MultiChainSwapRouter's own doc comment.
# CHAIN_BNB_ID=56
# CHAIN_BNB_RPC_URL=https://bsc-dataseed.binance.org
# CHAIN_BNB_RPC_URL_FALLBACK=https://bsc-dataseed1.defibit.io
# The real Binance-Peg USDC address on BNB Chain, confirmed via BscScan.
# CHAIN_BNB_USDC_ADDRESS=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d

# KyberSwapRouter (apps/api/src/trading/router/kyberswap-router.service.ts) prices
# Base/Arbitrum; OpenOceanRouter prices BNB Chain — see docs/TRADING.md#provider and
# MultiChainSwapRouter (apps/api/src/trading/router/multi-chain-swap-router.service.ts),
# bound to SWAP_ROUTER, for how a request's chainId picks between them. Neither documents
# an API key requirement for their public Swap APIs.
# KyberSwap: just an identifying string sent as the X-Client-Id header for rate-limit
# prioritization, per KyberSwap's own docs. Defaulted to "kamby" — override only if you
# want a distinct identifier (e.g. per-environment).
# KYBERSWAP_CLIENT_ID=kamby
# The wallet address that receives the platform fee — collected atomically by the swap
# transaction itself, never custodied by this backend in between.
PLATFORM_FEE_RECIPIENT_ADDRESS=0x0000000000000000000000000000000000000000
# No longer read by QuoteService as of 2026-09-16 — the EVM swap router now charges a
# tiered fee (PLATFORM_FEE_TIERS: 2% under $100, 1% $100-$499, 0.75% $500+), not a single
# flat rate. Left defined (harmless if set) for the same reason Solana's own
# SOLANA_JUPITER_PLATFORM_FEE_BPS below is — see docs/TRADING.md#fees.
PLATFORM_FEE_BPS=50

# Solana trading — see docs/TRADING.md#solana and docs/WALLET_SECURITY.md's Solana
# section. Off by default; every SOLANA_* var below is only required once this is true.
SOLANA_ENABLED=false
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional second Solana RPC endpoint — see docs/TRADING.md#rpc-failover.
# SOLANA_RPC_URL_FALLBACK=https://api.mainnet-beta.solana.com
# A USDC Associated Token Account owned by the treasury — NOT the treasury's raw wallet
# address. Jupiter's feeAccount must be a token account for the swap's own mint.
# SOLANA_TREASURY_USDC_ATA=replace-with-a-real-usdc-ata
# No longer read as of 2026-09-13. Solana's platform fee now resolves through the same
# PLATFORM_FEE_TIERS table EVM uses (see docs/TRADING.md#fees) — Solana's former separate
# two-tier schedule was reconciled into that single shared table. Left defined (harmless
# if set).
SOLANA_JUPITER_PLATFORM_FEE_BPS=50
# How much SOL a brand-new embedded wallet gets once, on creation, so it doesn't feel
# broken even though (launch scope) the wallet pays its own gas after that.
SOLANA_NEW_WALLET_TOPUP_SOL=0.01
# A small, separately-funded operational keypair (base58 secret key) that only ever sends
# that one fixed top-up transfer — never the (not yet built) gasless-relayer fee-payer key.
# SOLANA_TOPUP_FUNDING_SECRET_KEY=replace-with-a-real-base58-secret-key
# Required by Jupiter even on its free tier (1 req/sec) — their old keyless domain
# (quote-api.jup.ag) stopped resolving in production on 2026-09-12; the current API at
# api.jup.ag requires this header on every call. Get one at https://portal.jup.ag.
# SOLANA_JUPITER_API_KEY=replace-with-a-real-jupiter-api-key

# Gas relayer (USDC-native gas sponsorship) — see docs/GAS_RELAYER_PLAN.md. Off by default;
# GasRelayerService is wired into solana.module.ts and both HTTP routes are live, but stays
# fully inert until this is explicitly turned on and funded. The two vars below are required
# only once this is true (enforced at boot — see env.ts's third superRefine).
SOLANA_GAS_RELAYER_ENABLED=false
# A small, separately-funded operational keypair (base58 secret key) that co-signs as fee
# payer for a sponsored trade — never used for anything else. Never the same key as
# SOLANA_TOPUP_FUNDING_SECRET_KEY above (a different operational role, funded separately).
# SOLANA_GAS_RELAYER_FEE_PAYER_SECRET_KEY=replace-with-a-real-base58-secret-key
# ~one signature fee + one ATA-creation rent, with headroom — the hard ceiling a simulated
# sponsored transaction's real cost is checked against before ever co-signing for real.
# SOLANA_GAS_RELAYER_MAX_LAMPORTS_CEILING=3000000
# Rollout gate, not a security boundary — comma-separated wallet addresses. When set, only
# these wallets can use gas sponsorship; everyone else gets the exact same "not enabled"
# response as when the relayer is off entirely. Genuinely independent of
# SOLANA_GAS_RELAYER_ENABLED — never required. Intended real use: your own test wallet(s)
# for the first live production cycle, then simply unset this to open it to every user.
# SOLANA_GAS_RELAYER_TEST_WALLET_ADDRESSES=YourOwnTestWalletAddressHere
