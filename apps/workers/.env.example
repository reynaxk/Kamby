# Copy to .env for local development (docker compose up -d provides matching DB/Redis).
NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://kamby:kamby@localhost:5432/kamby?schema=public
REDIS_URL=redis://localhost:6379

# One chain per deployed workers instance — genuinely different from apps/api's CHAINS
# (a single process trading on several chains at once). Market ingestion here is built
# around one ticker polling one chain's logs; adding Arbitrum or BNB Chain market data
# means deploying a SECOND (or third) Railway workers service, each with its own copy of
# this file pointed at a different chain below — not a comma-separated list on this one.
# apps/api's own multi-chain trading/quoting is unaffected either way; this only concerns
# background market-data ingestion (candles, trenches, the ticker that feeds them).
#
# CHAIN_IDENTIFIER must have a real, curated entry in
# market/seed-markets.ts's SEED_MARKETS_BY_CHAIN_IDENTIFIER — main.ts throws at boot,
# loudly, rather than starting with an empty/wrong seed list, if it doesn't. Base and BNB
# Chain both have real entries there as of 2026-09-16; add a new chain's own curated pool
# list (verified live on-chain, not guessed) before pointing a deployment at it.
#
# Base's own public RPC works with no signup and is fine for local dev; it rate-limits
# under sustained concurrent load, so production should point this at a dedicated
# provider (Alchemy/QuickNode) instead — never commit that URL/key.
CHAIN_IDENTIFIER=eip155:8453
CHAIN_NAME=Base
CHAIN_NATIVE_SYMBOL=ETH
CHAIN_RPC_URL=https://mainnet.base.org

# Arbitrum, as a SEPARATE workers deployment's full config (not additive to the above) —
# real values, same chain apps/api's own commented CHAIN_ARBITRUM_* block already uses.
# NOT YET a real SEED_MARKETS_BY_CHAIN_IDENTIFIER entry — Arbitrum was explicitly dropped
# from the 2026-09-16 multi-chain push, unlike BNB Chain below. Add a curated
# ARBITRUM_SEED_MARKETS list (real, verified pools — see that file's own doc comment)
# before ever setting CHAIN_IDENTIFIER to this value.
# CHAIN_IDENTIFIER=eip155:42161
# CHAIN_NAME=Arbitrum
# CHAIN_NATIVE_SYMBOL=ETH
# CHAIN_RPC_URL=https://arb1.arbitrum.io/rpc
# CHAIN_RPC_URL_FALLBACK=https://arbitrum.llamarpc.com

# BNB Chain, same deployment-isolation deal as Arbitrum above — its own separate service,
# not a third value appended to CHAIN_IDENTIFIER above. Ready to deploy as-is: a real,
# on-chain-verified BNB_SEED_MARKETS list already exists (2 pools — WBNB/USDC then
# USDT/WBNB, PancakeSwap V3, confirmed ABI-compatible with the existing UniswapV3PoolReader
# live on-chain 2026-09-16). Needs its own dedicated RPC provider before going live — the
# free public bsc-dataseed endpoint below is fine for a first boot/local test only, same
# rate-limiting caveat as Base's public RPC above, not a production choice.
# CHAIN_IDENTIFIER=eip155:56
# CHAIN_NAME=BNB Chain
# CHAIN_NATIVE_SYMBOL=BNB
# CHAIN_RPC_URL=https://bsc-dataseed.binance.org
# CHAIN_RPC_URL_FALLBACK=https://bsc-dataseed1.defibit.io
# CHAIN_RPC_URL=https://bsc-dataseed.binance.org
# CHAIN_RPC_URL_FALLBACK=https://bsc-dataseed1.defibit.io
# Optional second RPC endpoint — see docs/TRADING.md#rpc-failover. Recommended: QuickNode's
# Base RPC has already exhausted its daily quota once in production, breaking market
# ingestion with no fallback configured. Uncomment once you have a second provider.
# CHAIN_RPC_URL_FALLBACK=https://mainnet.base.org

HEARTBEAT_INTERVAL_SECONDS=60
MARKET_INGESTION_INTERVAL_SECONDS=60
# Phase 3 — see docs/TRADING.md#transaction-lifecycle. How often PENDING trades nobody is
# actively watching get checked for a real on-chain receipt.
TRADE_SWEEP_INTERVAL_SECONDS=30

# Solana's counterpart to the sweep above — see docs/TRADING.md#transaction-lifecycle. Off
# by default, same convention apps/api's SOLANA_ENABLED already uses.
SOLANA_ENABLED=false
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional second Solana RPC endpoint — see docs/TRADING.md#rpc-failover.
# SOLANA_RPC_URL_FALLBACK=https://api.mainnet-beta.solana.com
SOLANA_SWEEP_INTERVAL_SECONDS=30

# Treasury balance monitoring — see solana/treasury-balance-monitor.ts's own doc comment.
# Public keys only, never the secret keys apps/api holds for these same wallets — a balance
# check needs no signing capability. Each wallet is independently opt-in: set its public key
# to turn monitoring for it on, leave it unset to skip it (a valid pre-launch state before
# that wallet is funded/enabled on the api side).
SOLANA_TREASURY_MONITOR_INTERVAL_SECONDS=300
# SOLANA_TOPUP_FUNDING_PUBLIC_KEY=replace-with-the-real-public-key
SOLANA_TOPUP_WARN_THRESHOLD_LAMPORTS=50000000
# SOLANA_GAS_RELAYER_FEE_PAYER_PUBLIC_KEY=replace-with-the-real-public-key
SOLANA_GAS_RELAYER_WARN_THRESHOLD_LAMPORTS=100000000

# Pump.fun bonding-curve ingestion (FRESH/NEAR_GRADUATED/JUST_GRADUATED trenches) — see
# docs/TRADING.md#pump-fun-trenches. A persistent WebSocket subscription, not a tick;
# requires SOLANA_ENABLED=true and reuses SOLANA_RPC_URL's host for its own wss://
# connection. Note (2026-09-14): confirm your Helius (or other provider) key actually has
# WebSocket access enabled before turning this on — a key that works fine over plain HTTPS
# can still 401 on the WebSocket upgrade specifically if that's gated separately.
PUMPFUN_INGESTION_ENABLED=false

# Phase 4 — see docs/NOTIFICATIONS.md#whale-trades. A single trade at/above this USD value
# triggers a WHALE_TRADE alert.
WHALE_TRADE_USD_THRESHOLD=25000

# Realized-PnL ledger sweep — see docs/TRADER_INTELLIGENCE.md#realized-pnl and
# pnl/pnl-ledger-sweep.ts's own doc comment. Deliberately cross-chain (reads both
# trade_transactions and solana_trade_transactions regardless of this deployment's own
# CHAIN_IDENTIFIER above) — enable on exactly ONE workers deployment, never on every
# per-chain replica (e.g. leave this off on a workers-bnb-style deployment if the primary
# workers deployment already has it on), or the same backlog gets raced concurrently. The
# sweep's own Postgres advisory lock is a correctness backstop for that, not a license to
# enable it on more than one deployment.
PNL_LEDGER_SWEEP_ENABLED=false
PNL_LEDGER_SWEEP_INTERVAL_SECONDS=60
